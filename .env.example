# HostelOS Environment Variables

# Application
NEXT_PUBLIC_APP_NAME="HostelOS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DESCRIPTION="Next-Gen Hostel & Accommodation Management System"

# Environment Configuration
NODE_ENV="development"

# Supabase Integration Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-only Supabase Key (Optional placeholder for elevated administrative operations)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

